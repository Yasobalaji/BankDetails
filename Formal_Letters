<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bank Letter Generator — Pro</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600;700&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0b0d12;--surface:#11141c;--surface2:#171b26;
  --border:#22273a;--border2:#2c3248;
  --gold:#c9a84c;--gold-l:#e8c96a;--gold-d:rgba(201,168,76,.13);--gold-b:rgba(201,168,76,.26);
  --text:#e5e3dd;--muted:#888898;--dim:#484860;
  --blue:#4a7fa5;--green:#4aaa7a;--red:#a84a4a;
  --paper-bg:#fcfbf8;--r:9px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;flex-direction:column;height:100vh;overflow:hidden}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}

/* TOPBAR */
#topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 14px;height:52px;display:flex;align-items:center;gap:9px;flex-shrink:0;z-index:50}
.logo{font-family:'Playfair Display',serif;font-size:16px;font-weight:900;color:var(--gold);white-space:nowrap;display:flex;align-items:center;gap:6px}
.logo-dot{width:6px;height:6px;border-radius:50%;background:var(--gold)}
.vd{width:1px;height:26px;background:var(--border);flex-shrink:0}
.tf{display:flex;flex-direction:column;gap:1px;min-width:0}
.tf label{font-size:9px;color:var(--dim);letter-spacing:.1em;text-transform:uppercase;font-family:'DM Mono',monospace;white-space:nowrap}
.tf select,.tf input{background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;padding:4px 8px;outline:none;transition:border-color .15s;height:28px}
.tf select{min-width:148px;cursor:pointer}.tf input{min-width:100px}
.tf select:focus,.tf input:focus{border-color:var(--gold)}
.top-actions{margin-left:auto;display:flex;gap:6px;align-items:center}
.btn{padding:5px 13px;border-radius:7px;border:none;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:5px;white-space:nowrap;height:28px}
.btn-gold{background:var(--gold);color:#0b0d12}.btn-gold:hover{background:var(--gold-l)}
.btn-outline{background:transparent;color:var(--muted);border:1px solid var(--border2)}.btn-outline:hover{background:var(--surface2);color:var(--text)}
.btn-blue{background:rgba(74,127,165,.16);color:#7ab5d8;border:1px solid rgba(74,127,165,.28)}.btn-blue:hover{background:rgba(74,127,165,.28)}
.btn-green{background:rgba(74,170,122,.16);color:#7ad4a8;border:1px solid rgba(74,170,122,.28)}.btn-green:hover{background:rgba(74,170,122,.28)}
.btn-purple{background:rgba(140,100,200,.16);color:#c0a0e8;border:1px solid rgba(140,100,200,.28)}.btn-purple:hover{background:rgba(140,100,200,.28)}
.btn:disabled{opacity:.38;cursor:not-allowed}

/* SHELL */
#shell{display:flex;flex:1;overflow:hidden}

/* SIDEBAR */
#sidebar{width:244px;min-width:190px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden}
#sb-top{padding:11px 11px 8px;border-bottom:1px solid var(--border);flex-shrink:0;display:flex;flex-direction:column;gap:7px}
#sb-search{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:7px 10px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:12px;outline:none;transition:border-color .15s}
#sb-search:focus{border-color:var(--gold)}
#sb-search::placeholder{color:var(--dim)}
#upload-zone{border:1.5px dashed var(--border2);border-radius:7px;padding:8px 11px;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:8px;background:transparent;color:var(--muted);font-size:11px;font-weight:500;font-family:'DM Sans',sans-serif;width:100%;text-align:left}
#upload-zone:hover{border-color:var(--gold);color:var(--gold);background:var(--gold-d)}
#cat-list{flex:1;overflow-y:auto;padding:5px 0}
.cat-btn{display:flex;align-items:center;gap:7px;width:100%;padding:7px 12px;background:none;border:none;color:var(--muted);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;cursor:pointer;text-align:left;transition:all .15s;border-left:3px solid transparent}
.cat-btn:hover{color:var(--text);background:var(--surface2)}
.cat-btn.active{color:var(--gold);background:var(--gold-d);border-left-color:var(--gold)}
.cat-btn .emoji{font-size:13px;width:16px;text-align:center;flex-shrink:0}
.cat-btn .badge{margin-left:auto;font-family:'DM Mono',monospace;font-size:10px;color:var(--dim);background:var(--surface2);padding:1px 5px;border-radius:10px}
.cat-btn.active .badge{color:var(--gold);background:var(--gold-d)}

/* MAIN */
#main{flex:1;display:flex;flex-direction:column;overflow:hidden}

/* GRID */
#grid-view{flex:1;overflow-y:auto;padding:18px}
.sec-hdr{display:flex;align-items:baseline;gap:10px;margin-bottom:12px;padding-bottom:9px;border-bottom:1px solid var(--border)}
.sec-hdr h2{font-family:'Playfair Display',serif;font-size:17px;color:var(--gold)}
.sec-hdr span{font-size:11px;color:var(--dim)}
.lg{display:grid;grid-template-columns:repeat(auto-fill,minmax(268px,1fr));gap:10px;margin-bottom:28px}
.lcard{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);cursor:pointer;transition:border-color .18s,transform .15s;overflow:hidden;animation:fu .2s ease both}
.lcard:hover{border-color:var(--gold);transform:translateY(-2px)}
.lcard.custom{border-left:3px solid #8c64c8}
@keyframes fu{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.lcard-h{padding:10px 12px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:6px}
.lcard-h h3{font-size:12px;font-weight:600;color:var(--text);flex:1}
.ltag{font-family:'DM Mono',monospace;font-size:9px;padding:2px 6px;border-radius:20px;background:var(--gold-d);color:var(--gold);white-space:nowrap}
.ltag.custom{background:rgba(140,100,200,.14);color:#c0a0e8}
.lcard-prev{padding:8px 12px;font-size:11px;color:var(--dim);line-height:1.5;height:60px;overflow:hidden;position:relative;font-family:'DM Mono',monospace}
.lcard-prev::after{content:'';position:absolute;bottom:0;left:0;right:0;height:26px;background:linear-gradient(transparent,var(--surface))}
.lcard-ft{padding:7px 12px;display:flex;gap:5px;align-items:center}
.bxs{padding:4px 10px;border-radius:5px;border:none;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s}
.bxs-gold{background:var(--gold-d);color:var(--gold);border:1px solid var(--gold-b)}.bxs-gold:hover{background:var(--gold);color:#0b0d12}
.bxs-ghost{background:transparent;color:var(--muted);border:1px solid var(--border)}.bxs-ghost:hover{background:var(--surface2);color:var(--text)}
.bxs-del{background:rgba(168,74,74,.12);color:#d48a8a;border:1px solid rgba(168,74,74,.22);margin-left:auto}.bxs-del:hover{background:rgba(168,74,74,.24)}
.no-res{text-align:center;padding:60px 20px;color:var(--dim)}
.no-res .ico{font-size:32px;margin-bottom:8px}

/* EDITOR */
#editor-view{flex:1;display:none;flex-direction:column;overflow:hidden}
#editor-view.open{display:flex}
#ed-topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:8px 16px;display:flex;align-items:center;gap:9px;flex-shrink:0}
#ed-title{font-family:'Playfair Display',serif;font-size:14px;font-weight:700;color:var(--gold);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#ed-body{display:flex;flex:1;overflow:hidden}

/* DETAILS PANEL */
#dp{width:224px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:5px}
#dp h4{font-family:'DM Mono',monospace;font-size:9px;color:var(--dim);letter-spacing:.12em;text-transform:uppercase;margin:7px 0 3px;padding-top:3px;border-top:1px solid var(--border)}
#dp h4:first-child{margin-top:0;border-top:none}
.dpf{display:flex;flex-direction:column;gap:2px}
.dpf label{font-size:10px;color:var(--muted)}
.dpf input,.dpf select,.dpf textarea{background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:11px;padding:5px 8px;outline:none;transition:border-color .15s;width:100%}
.dpf input:focus,.dpf select:focus,.dpf textarea:focus{border-color:var(--gold)}
.dpf textarea{resize:vertical;min-height:44px;line-height:1.5}
.apply-btn{width:100%;padding:8px;border-radius:7px;border:none;background:var(--gold);color:#0b0d12;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;margin-top:4px}
.apply-btn:hover{background:var(--gold-l)}

/* PAPER WRAP */
#paper-wrap{flex:1;overflow-y:auto;background:var(--bg);padding:22px;display:flex;justify-content:center;align-items:flex-start}

/* A4 PAPER — portrait, no header, tight for single sheet */
.letter-paper{background:var(--paper-bg);width:210mm;border-radius:6px;box-shadow:0 10px 40px rgba(0,0,0,.55);overflow:hidden}
.lp-inner{padding:14mm 17mm 13mm;font-family:'Crimson Text',Georgia,serif;font-size:12pt;line-height:1.7;color:#1a1a1a;white-space:pre-wrap;word-break:break-word}

/* Inline field inputs */
.fi{display:inline-block;border:none;border-bottom:1.5px solid #b89f4a;background:rgba(201,168,76,.07);color:#1a3264;font-family:'Crimson Text',Georgia,serif;font-size:12pt;line-height:1.3;padding:0 4px;border-radius:3px 3px 0 0;outline:none;min-width:50px;transition:background .15s,border-color .15s;vertical-align:baseline}
.fi:focus{background:rgba(201,168,76,.14);border-bottom-color:var(--gold)}
.fi::placeholder{color:#b0916a;font-style:italic;font-size:10pt}
.fi.filled{border-bottom-color:#4aaa7a;background:rgba(74,170,122,.06);color:#1a3a1a}
.fi.auto-f{border-bottom-color:#4a7fa5;background:rgba(74,127,165,.06);color:#1a2a40}

/* progress */
.fill-prog{padding:6px 13px;background:var(--surface2);border-top:1px solid var(--border);display:flex;align-items:center;gap:9px;border-radius:0 0 6px 6px}
.fpbar{flex:1;height:3px;background:var(--border);border-radius:2px;overflow:hidden}
.fpbar-i{height:100%;background:var(--gold);transition:width .3s;border-radius:2px}
.fpcnt{font-family:'DM Mono',monospace;font-size:10px;color:var(--muted)}
.fpcnt b{color:var(--gold)}

/* MODAL */
.modal-bg{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.72);backdrop-filter:blur(5px);align-items:center;justify-content:center;padding:18px}
.modal-bg.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:12px;width:100%;max-width:490px;box-shadow:0 28px 56px rgba(0,0,0,.6);max-height:90vh;display:flex;flex-direction:column}
.modal-head{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.modal-head h3{font-family:'Playfair Display',serif;font-size:15px;color:var(--gold)}
.modal-x{background:none;border:none;color:var(--muted);font-size:20px;cursor:pointer;line-height:1}.modal-x:hover{color:var(--text)}
.modal-body{padding:18px 20px;overflow-y:auto;flex:1}
.tab-row{display:flex;gap:7px;margin-bottom:14px}
.tab-row .btn{flex:1;justify-content:center;font-size:11px}
.upload-drop{border:2px dashed var(--border2);border-radius:9px;padding:30px 20px;text-align:center;cursor:pointer;transition:all .2s;position:relative}
.upload-drop:hover,.upload-drop.drag{border-color:var(--gold);background:var(--gold-d)}
.upload-drop input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.ud-ico{font-size:32px;margin-bottom:8px}
.upload-drop p{font-size:12px;color:var(--muted);line-height:1.6}.upload-drop p b{color:var(--text)}
.upload-drop small{font-size:10px;color:var(--dim);font-family:'DM Mono',monospace}
.up-st{margin-top:12px;padding:9px 12px;border-radius:7px;font-size:11px;display:none}
.up-st.ok{background:rgba(74,170,122,.11);color:#7ad4a8;border:1px solid rgba(74,170,122,.24);display:block}
.up-st.err{background:rgba(168,74,74,.11);color:#d48a8a;border:1px solid rgba(168,74,74,.24);display:block}
.tips{margin-top:12px;padding:10px 13px;background:var(--surface2);border-radius:7px;font-size:11px;color:var(--muted);line-height:1.8}.tips b{color:var(--text)}
.mf{display:none;flex-direction:column;gap:7px}
.mf.show{display:flex}
.mf-row{display:flex;flex-direction:column;gap:2px}
.mf-row label{font-size:10px;color:var(--muted)}
.mf-row input,.mf-row select,.mf-row textarea{background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:11px;padding:6px 9px;outline:none;width:100%}
.mf-row input:focus,.mf-row select:focus,.mf-row textarea:focus{border-color:var(--gold)}
.mf-row textarea{min-height:90px;resize:vertical;line-height:1.6;font-family:'DM Mono',monospace;font-size:10px}
.modal-foot{padding:12px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:7px;flex-shrink:0}

/* PRINT — A4 portrait single sheet */
@media print{
  @page{size:A4 portrait;margin:0}
  html,body{height:auto;overflow:visible;background:#fff}
  #topbar,#sidebar,#ed-topbar,#dp,#grid-view,.fill-prog,.no-print,.modal-bg{display:none!important}
  #shell,#main,#editor-view,#ed-body,#paper-wrap{display:block!important;overflow:visible!important;height:auto!important;width:100%!important}
  #editor-view{display:block!important}
  #paper-wrap{padding:0!important;background:#fff!important;display:block!important}
  .letter-paper{box-shadow:none!important;border-radius:0!important;width:100%!important;background:#fff!important;page-break-inside:avoid}
  .lp-inner{padding:11mm 15mm 10mm!important;font-size:10pt!important;line-height:1.62!important;color:#000!important}
  .fi{border:none!important;border-bottom:1px solid #999!important;background:transparent!important;color:#000!important;font-size:10pt!important;padding:0!important}
}

/* TOAST */
#toast{position:fixed;bottom:18px;right:18px;z-index:999;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px 15px;font-size:12px;color:var(--text);box-shadow:0 8px 24px rgba(0,0,0,.5);transform:translateY(14px);opacity:0;transition:all .25s;pointer-events:none}
#toast.show{transform:translateY(0);opacity:1}
</style>
</head>
<body>

<!-- TOPBAR -->
<div id="topbar">
  <div class="logo"><div class="logo-dot"></div>BankLetters <span style="font-size:9px;font-family:'DM Mono',monospace;color:var(--muted);margin-left:2px">PRO</span></div>
  <div class="vd"></div>
  <div class="tf">
    <label>🏦 Bank</label>
    <select id="tb-bank" onchange="syncG()">
      <option value="">— Select Bank —</option>
      <option>State Bank of India (SBI)</option><option>HDFC Bank</option><option>ICICI Bank</option>
      <option>Axis Bank</option><option>Punjab National Bank (PNB)</option><option>Bank of Baroda (BOB)</option>
      <option>Canara Bank</option><option>Union Bank of India</option><option>Kotak Mahindra Bank</option>
      <option>IndusInd Bank</option><option>Yes Bank</option><option>IDFC First Bank</option>
      <option>Federal Bank</option><option>South Indian Bank</option><option>Bank of India (BOI)</option>
      <option>Indian Bank</option><option>Central Bank of India</option><option>UCO Bank</option>
      <option>Indian Overseas Bank</option><option>Karnataka Bank</option><option>RBL Bank</option>
      <option>Bandhan Bank</option><option>CSB Bank</option><option>City Union Bank</option>
      <option value="custom">✏️ Other / Custom</option>
    </select>
  </div>
  <div class="tf" id="cbank-wrap" style="display:none">
    <label>Custom Bank</label>
    <input id="tb-bank-c" placeholder="Bank name" oninput="syncG()">
  </div>
  <div class="tf"><label>🏢 Branch</label><input id="tb-branch" placeholder="Branch name" oninput="syncG()"></div>
  <div class="tf" style="min-width:82px"><label>🔢 Code</label><input id="tb-code" placeholder="001234" style="min-width:82px" oninput="syncG()"></div>
  <div class="tf"><label>📅 Date</label><input type="date" id="tb-date" oninput="syncG()"></div>
  <div class="vd"></div>
  <div class="top-actions">
    <button class="btn btn-outline no-print" id="btn-back" onclick="showGrid()" style="display:none">← Back</button>
    <button class="btn btn-blue no-print" id="btn-email" onclick="doEmail()" disabled>✉️ Email</button>
    <button class="btn btn-green no-print" id="btn-print" onclick="doPrint()" disabled>🖨️ Print A4</button>
  </div>
</div>

<!-- SHELL -->
<div id="shell">
<aside id="sidebar">
  <div id="sb-top">
    <input id="sb-search" placeholder="🔍  Search letters…" oninput="doSearch()">
    <button id="upload-zone" onclick="openModal()">
      <span style="font-size:15px">📎</span>
      <div>
        <div style="font-size:11px;font-weight:600">Add Letter Format</div>
        <div style="font-size:10px;color:var(--dim)">Upload .docx / .txt or manual</div>
      </div>
    </button>
  </div>
  <div id="cat-list"></div>
</aside>

<div id="main">
  <div id="grid-view"></div>

  <div id="editor-view">
    <div id="ed-topbar">
      <div id="ed-title">Letter Editor</div>
      <button class="btn btn-outline no-print" onclick="clearFields()" style="font-size:11px;padding:4px 10px;height:26px">🔄 Clear</button>
    </div>
    <div id="ed-body">
      <div id="dp">
        <h4>Your Details</h4>
        <div class="dpf"><label>Full Name</label><input id="dp-name" placeholder="Full name" oninput="syncG()"></div>
        <div class="dpf"><label>Account Number</label><input id="dp-acct" placeholder="Account no." oninput="syncG()"></div>
        <div class="dpf"><label>TIN Number</label><input id="dp-tin" placeholder="TIN" oninput="syncG()"></div>
        <div class="dpf"><label>Mobile Number</label><input id="dp-phone" type="tel" placeholder="Phone" oninput="syncG()"></div>
        <div class="dpf"><label>Email ID</label><input id="dp-email" type="email" placeholder="Email" oninput="syncG()"></div>
        <div class="dpf"><label>Full Address</label><textarea id="dp-addr" placeholder="Your full address" oninput="syncG()"></textarea></div>
        <h4>Branch Details</h4>
        <div class="dpf"><label>Branch Address</label><textarea id="dp-baddr" placeholder="Branch address & city" oninput="syncG()" style="min-height:40px"></textarea></div>
        <button class="apply-btn" onclick="applyAll()">⚡ Auto-Fill Letter</button>
      </div>

      <div id="paper-wrap">
        <div class="letter-paper" id="letter-paper">
          <div class="lp-inner" id="letter-content"></div>
          <div class="fill-prog no-print">
            <div class="fpbar"><div class="fpbar-i" id="fpbar-i" style="width:0%"></div></div>
            <div class="fpcnt"><b id="fp-done">0</b>/<span id="fp-total">0</span> fields filled</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<!-- UPLOAD MODAL -->
<div class="modal-bg" id="umodal" onclick="closeModal(event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-head">
      <h3>📎 Add New Letter Format</h3>
      <button class="modal-x" onclick="closeModal()">×</button>
    </div>
    <div class="modal-body">
      <div class="tab-row">
        <button class="btn btn-purple" id="tab-up-btn" onclick="switchTab('up')">📄 Upload .docx / .txt</button>
        <button class="btn btn-outline" id="tab-mn-btn" onclick="switchTab('mn')">✏️ Enter Manually</button>
      </div>

      <div id="tab-up">
        <div class="upload-drop" id="udrop">
          <input type="file" accept=".docx,.doc,.txt" id="flinput" onchange="handleFile(this)">
          <div class="ud-ico">📄</div>
          <p><b>Click to browse</b> or drag & drop</p>
          <small>Supports .docx · .txt</small>
        </div>
        <div class="up-st" id="up-st"></div>
        <div class="tips">
          <b>Tips for best results:</b><br>
          • Use <b>[FIELD NAME]</b> in your document for fillable blanks<br>
          • e.g. <b>[YOUR NAME]</b>, <b>[ACCOUNT NUMBER]</b>, <b>[DATE]</b><br>
          • The letter title is taken from the first line of the document
        </div>
      </div>

      <div id="tab-mn" style="display:none">
        <div class="mf show" id="mfform">
          <div class="mf-row"><label>Letter Title *</label><input id="mf-title" placeholder="e.g. Account Holder Consent Letter"></div>
          <div class="mf-row">
            <label>Category *</label>
            <select id="mf-cat">
              <option value="Z">⭐ My Custom Letters</option>
              <option value="A">🏦 A — Account Related</option>
              <option value="B">💳 B — ATM / Card</option>
              <option value="C">🌐 C — Online & Mobile</option>
              <option value="D">💰 D — Loans</option>
              <option value="E">📄 E — Statements & Certs</option>
              <option value="F">🔄 F — Personal Updates</option>
