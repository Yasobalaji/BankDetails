/* ═══════════ FIELD MAP ═══════════ */
const GMAP={
  "DATE":"date","BANK NAME":"bankName","BRANCH NAME & ADDRESS":"branchFull","BRANCH NAME":"branchName",
  "YOUR FULL NAME":"name","YOUR NAME":"name","ACCOUNT NUMBER":"acct",
  "TIN NUMBER":"tin","PHONE":"phone","PHONE NUMBER":"phone",
  "EMAIL":"email","EMAIL ID":"email","ADDRESS":"address","FULL ADDRESS":"address",
};
const CATS=[
  {id:"ALL",label:"All Letters",emoji:"📋"},{id:"A",label:"Account Related",emoji:"🏦"},
  {id:"B",label:"ATM / Card",emoji:"💳"},{id:"C",label:"Online & Mobile",emoji:"🌐"},
  {id:"D",label:"Loans",emoji:"💰"},{id:"E",label:"Statements & Certs",emoji:"📄"},
  {id:"F",label:"Personal Updates",emoji:"🔄"},{id:"G",label:"Transactions",emoji:"💸"},
  {id:"H",label:"Cheque & DD",emoji:"📑"},{id:"I",label:"Business Banking",emoji:"🏢"},
  {id:"J",label:"Complaints",emoji:"⚠️"},{id:"K",label:"Security",emoji:"🔒"},
  {id:"L",label:"Miscellaneous",emoji:"📦"},{id:"Z",label:"My Custom Letters",emoji:"⭐"},
];
const CN={A:"Account Related Letters",B:"ATM / Debit / Credit Card Letters",C:"Online Banking & Mobile Banking",D:"Loan Related Letters",E:"Statement & Certificate Requests",F:"Personal Detail Updates",G:"Transaction & Payment Issues",H:"Cheque & Demand Draft Letters",I:"Business / Company Banking",J:"Complaints & Disputes",K:"Security & Access",L:"Miscellaneous Letters",Z:"My Custom Letters"};

/* ═══════════ STATE ═══════════ */
let CUSTOM=[];try{CUSTOM=JSON.parse(localStorage.getItem('blc')||'[]')}catch(e){}
let LETTERS=[...BL,...CUSTOM];
let G={bankName:"",branchName:"",branchFull:"",date:"",name:"",acct:"",tin:"",phone:"",email:"",address:""};
let aCat="ALL",srchQ="",curL=null,curTab="up";

/* ═══════════ INIT ═══════════ */
window.onload=()=>{
  const d=new Date();
  document.getElementById('tb-date').value=d.toISOString().split('T')[0];
  G.date=fd(d.toISOString().split('T')[0]);
  buildSB();buildGrid();
};
function fd(s){const p=s.split('-');return`${p[2]}/${p[1]}/${p[0]}`}

/* ═══════════ SYNC ═══════════ */
function syncG(){
  const sel=document.getElementById('tb-bank').value;
  const isc=sel==='custom';
  document.getElementById('cbank-wrap').style.display=isc?'flex':'none';
  G.bankName=isc?document.getElementById('tb-bank-c').value:sel;
  G.branchName=document.getElementById('tb-branch').value;
  const raw=document.getElementById('tb-date').value;
  if(raw)G.date=fd(raw);
  G.name=document.getElementById('dp-name').value;
  G.acct=document.getElementById('dp-acct').value;
  G.tin=document.getElementById('dp-tin').value;
  G.phone=document.getElementById('dp-phone').value;
  G.email=document.getElementById('dp-email').value;
  G.address=document.getElementById('dp-addr').value.replace(/\n/g,' ');
  const ba=document.getElementById('dp-baddr').value.replace(/\n/g,' ');
  G.branchFull=(G.branchName||'')+(ba?', '+ba:'');
}
function applyAll(){
  if(!curL)return;
  document.querySelectorAll('#letter-content .fi').forEach(inp=>{
    const gk=GMAP[inp.dataset.key];
    if(gk&&G[gk]){inp.value=G[gk];inp.classList.add('auto-f');inp.classList.remove('filled');autoSz(inp);}
  });
  updProg();toast('⚡ Auto-filled matching fields');
}

/* ═══════════ SIDEBAR ═══════════ */
function buildSB(){
  const hasCust=LETTERS.some(l=>l.cat==='Z');
  document.getElementById('cat-list').innerHTML=CATS.filter(c=>c.id!=='Z'||hasCust).map(c=>{
    const cnt=c.id==='ALL'?LETTERS.length:LETTERS.filter(l=>l.cat===c.id).length;
    if(!cnt&&c.id!=='ALL')return'';
    return`<button class="cat-btn${c.id===aCat?' active':''}" onclick="setCat('${c.id}')"><span class="emoji">${c.emoji}</span><span>${c.label}</span><span class="badge">${cnt}</span></button>`;
  }).join('');
}
function setCat(id){aCat=id;buildSB();showGrid();buildGrid()}
function doSearch(){srchQ=document.getElementById('sb-search').value;buildGrid()}

/* ═══════════ GRID ═══════════ */
function showGrid(){
  document.getElementById('grid-view').style.display='block';
  document.getElementById('editor-view').classList.remove('open');
  document.getElementById('btn-back').style.display='none';
  document.getElementById('btn-email').disabled=true;
  document.getElementById('btn-print').disabled=true;
  curL=null;
}
function buildGrid(){
  const gv=document.getElementById('grid-view');
  const q=srchQ.toLowerCase();
  const fl=LETTERS.filter(l=>(aCat==='ALL'||l.cat===aCat)&&(!q||l.title.toLowerCase().includes(q)||l.tag.toLowerCase().includes(q)));
  if(!fl.length){gv.innerHTML=`<div class="no-res"><div class="ico">🔍</div><p>No letters found</p></div>`;return;}
  const grp={};fl.forEach(l=>{if(!grp[l.cat])grp[l.cat]=[];grp[l.cat].push(l);});
  gv.innerHTML=Object.entries(grp).map(([cat,ls])=>`
    <div>
      <div class="sec-hdr"><h2>${CATS.find(c=>c.id===cat)?.emoji||''} ${CN[cat]}</h2><span>${ls.length} format${ls.length>1?'s':''}</span></div>
      <div class="lg">${ls.map(l=>{
        const idx=LETTERS.indexOf(l);
        const isC=l.custom||l.cat==='Z';
        const prev=l.body.replace(/\[[^\]]+\]/g,'…').substring(0,110);
        return`<div class="lcard${isC?' custom':''}" onclick="openEd(${idx})">
          <div class="lcard-h"><h3>${l.title}</h3><span class="ltag${isC?' custom':''}">${l.tag}</span></div>
          <div class="lcard-prev">${prev}</div>
          <div class="lcard-ft">
            <button class="bxs bxs-gold" onclick="event.stopPropagation();openEd(${idx})">✏️ Open & Fill</button>
            <button class="bxs bxs-ghost" onclick="event.stopPropagation();copyRaw(${idx},this)">📋 Copy</button>
            ${isC?`<button class="bxs bxs-del" onclick="event.stopPropagation();delL(${idx})">🗑</button>`:''}
          </div>
        </div>`;
      }).join('')}</div>
    </div>`).join('');
}

/* ═══════════ EDITOR ═══════════ */
function openEd(idx){
  curL=LETTERS[idx];
  document.getElementById('ed-title').textContent=curL.title;
  document.getElementById('grid-view').style.display='none';
  document.getElementById('editor-view').classList.add('open');
  document.getElementById('btn-back').style.display='flex';
  document.getElementById('btn-email').disabled=false;
  document.getElementById('btn-print').disabled=false;
  syncG();renderL();
}
function renderL(){
  const c=document.getElementById('letter-content');c.innerHTML='';
  if(!curL)return;
  const re=/\[([^\]]+)\]/g;let li=0,m;
  const fr=document.createDocumentFragment();
  while((m=re.exec(curL.body))!==null){
    if(m.index>li)fr.appendChild(document.createTextNode(curL.body.slice(li,m.index)));
    const fn=m[1],key=fn.trim().toUpperCase();
    const inp=document.createElement('input');
    inp.type='text';inp.className='fi';inp.placeholder=fn;inp.dataset.key=key;inp.dataset.orig=fn;
    const gk=GMAP[key];
    if(gk&&G[gk]){inp.value=G[gk];inp.classList.add('auto-f');}
    inp.style.width=Math.max(fn.length*7+20,50)+'px';
    inp.addEventListener('input',function(){
      autoSz(this);
      this.value?this.classList.add('filled'):this.classList.remove('filled','auto-f');
      document.querySelectorAll(`.fi[data-key="${this.dataset.key}"]`).forEach(el=>{
        if(el!==this){el.value=this.value;autoSz(el);el.value?el.classList.add('filled'):el.classList.remove('filled','auto-f');}
      });
      updProg();
    });
    fr.appendChild(inp);li=m.index+m[0].length;
  }
  if(li<curL.body.length)fr.appendChild(document.createTextNode(curL.body.slice(li)));
  c.appendChild(fr);updProg();
}
function autoSz(inp){
  const s=document.createElement('span');
  s.style.cssText='position:absolute;visibility:hidden;white-space:pre;font-family:Crimson Text,Georgia,serif;font-size:12pt;padding:0 4px';
  s.textContent=inp.value||inp.placeholder;document.body.appendChild(s);
  inp.style.width=Math.max(s.offsetWidth+16,50)+'px';document.body.removeChild(s);
}
function updProg(){
  const all=document.querySelectorAll('#letter-content .fi');
  const done=[...all].filter(i=>i.value.trim()).length;
  const pct=all.length?Math.round(done/all.length*100):0;
  document.getElementById('fpbar-i').style.width=pct+'%';
  document.getElementById('fp-done').textContent=done;
  document.getElementById('fp-total').textContent=all.length;
}
function clearFields(){
  document.querySelectorAll('#letter-content .fi').forEach(i=>{i.value='';i.classList.remove('filled','auto-f');autoSz(i);});
  updProg();
}
function getFilledTxt(){
  if(!curL)return'';
  let t=curL.body;
  const vals={};
  document.querySelectorAll('#letter-content .fi').forEach(i=>{if(!vals[i.dataset.orig])vals[i.dataset.orig]=i.value||`[${i.dataset.orig}]`;});
  Object.entries(vals).forEach(([k,v])=>{t=t.split('['+k+']').join(v);});
  return t;
}

/* ═══════════ PRINT / EMAIL ═══════════ */
function doPrint(){if(!curL)return;window.print();}
function doEmail(){
  if(!curL)return;
  const sub=encodeURIComponent(curL.title+(G.bankName?' — '+G.bankName:''));
  const bdy=encodeURIComponent(getFilledTxt());
  if(bdy.length>1800){navigator.clipboard.writeText(getFilledTxt());toast('📋 Letter copied — paste into your email');}
  else window.location.href=`mailto:?subject=${sub}&body=${bdy}`;
}
function copyRaw(idx,btn){
  navigator.clipboard.writeText(LETTERS[idx].body).then(()=>{btn.textContent='✅';setTimeout(()=>btn.textContent='📋 Copy',2000);});
}

/* ═══════════ UPLOAD MODAL ═══════════ */
function openModal(){document.getElementById('umodal').classList.add('open');resetModal();}
function closeModal(e){if(!e||e.target===document.getElementById('umodal'))document.getElementById('umodal').classList.remove('open');}
function resetModal(){
  document.getElementById('up-st').className='up-st';document.getElementById('up-st').textContent='';
  document.getElementById('flinput').value='';
  ['mf-title','mf-body','mf-tag'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('mf-cat').value='Z';
  switchTab('up');
}
function switchTab(t){
  curTab=t;
  document.getElementById('tab-up').style.display=t==='up'?'block':'none';
  document.getElementById('tab-mn').style.display=t==='mn'?'block':'none';
  document.getElementById('tab-up-btn').className='btn '+(t==='up'?'btn-purple':'btn-outline');
  document.getElementById('tab-mn-btn').className='btn '+(t==='mn'?'btn-purple':'btn-outline');
}
function handleFile(input){
  const file=input.files[0];if(!file)return;
  const st=document.getElementById('up-st');
  st.className='up-st';st.textContent='Reading file…';st.style.display='block';
  const ext=file.name.split('.').pop().toLowerCase();
  if(ext==='txt'){
    const r=new FileReader();r.onload=e=>procTxt(e.target.result,file.name);r.readAsText(file);
  }else if(ext==='docx'||ext==='doc'){
    if(typeof mammoth==='undefined'){st.className='up-st err';st.textContent='⚠️ Could not load mammoth.js. Try .txt format or enter manually.';return;}
    const r=new FileReader();r.onload=e=>{
      mammoth.extractRawText({arrayBuffer:e.target.result}).then(res=>procTxt(res.value,file.name)).catch(()=>{st.className='up-st err';st.textContent='❌ Could not read .docx. Try saving as .txt and uploading again.';});
    };r.readAsArrayBuffer(file);
  }else{st.className='up-st err';st.textContent='❌ Unsupported type. Use .docx or .txt';}
}
function procTxt(txt,fname){
  const st=document.getElementById('up-st');
  txt=txt.trim();
  if(!txt){st.className='up-st err';st.textContent='❌ File appears empty.';return;}
  const lines=txt.split('\n').map(l=>l.trim()).filter(l=>l);
  const guessTitle=lines[0].replace(/^(subject:|to:|date:)/i,'').trim()||fname.replace(/\.(docx?|txt)$/i,'');
  switchTab('mn');
  document.getElementById('mf-title').value=guessTitle;
  document.getElementById('mf-body').value=txt;
  document.getElementById('mf-cat').value='Z';
  document.getElementById('mf-tag').value='Custom';
  st.className='up-st ok';
  st.textContent=`✅ "${fname}" loaded — ${(txt.match(/\[[^\]]+\]/g)||[]).length} fields detected. Review and click Save.`;
}
function saveLetter(){
  const title=document.getElementById('mf-title').value.trim();
  const body=document.getElementById('mf-body').value.trim();
  const cat=document.getElementById('mf-cat').value;
  const tag=document.getElementById('mf-tag').value.trim()||'Custom';
  if(!title||!body){toast('⚠️ Title and body are required');return;}
  const nl={cat,title,tag,body,custom:true};
  CUSTOM.push(nl);
  try{localStorage.setItem('blc',JSON.stringify(CUSTOM));}catch(e){}
  LETTERS=[...BL,...CUSTOM];
  buildSB();buildGrid();closeModal();
  toast(`✅ "${title}" saved to My Custom Letters`);
}
function delL(idx){
  const l=LETTERS[idx];
  if(!confirm(`Delete "${l.title}"?`))return;
  CUSTOM=CUSTOM.filter(c=>c!==l);
  try{localStorage.setItem('blc',JSON.stringify(CUSTOM));}catch(e){}
  LETTERS=[...BL,...CUSTOM];
  buildSB();buildGrid();toast('🗑 Letter format deleted');
}

/* drag/drop */
const udrop=document.getElementById('udrop');
udrop.addEventListener('dragover',e=>{e.preventDefault();udrop.classList.add('drag')});
udrop.addEventListener('dragleave',()=>udrop.classList.remove('drag'));
udrop.addEventListener('drop',e=>{
  e.preventDefault();udrop.classList.remove('drag');
  const f=e.dataTransfer.files[0];
  if(f){const dt=new DataTransfer();dt.items.add(f);document.getElementById('flinput').files=dt.files;handleFile(document.getElementById('flinput'));}
});

/* toast */
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2800);}
</script>
